                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    p.ProductoID,
    p.Producto AS NombreProducto,
    c.Categoria AS NombreCategoria,
    pr.Proveedor AS NombreProveedor,
    pr.Ciudad AS CiudadProveedor,
    pr.Pais AS PaisProveedor,
    c.DescripcionLimpia AS DescripcionCategoria
FROM Productos p
LEFT JOIN (
    SELECT 
        CategoriaID, 
        Categoria, 
        CONVERT(NVARCHAR(200), Descripcion) AS DescripcionLimpia
    FROM Categorias
) c ON p.CategoriaID = c.CategoriaID
LEFT JOIN Proveedores pr ON p.ProveedorID = pr.ProveedorID;</property>
