            <component
              refId="Package\Fact ventas\Fact_Ventas Origen"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Fact_Ventas Origen"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    dp.SK_Producto,
    dc.SK_Cliente,
    de.SK_Empleado,
    ISNULL(dt.SK_Transportista, -1) AS SK_Transportista,
    CONVERT(INT, CONVERT(VARCHAR(8), o.FechaOrden, 112)) AS SK_FechaOrden,
    ISNULL(CONVERT(INT, CONVERT(VARCHAR(8), o.FechaEnvio, 112)), -1) AS SK_FechaEnvio,
    do.Cantidad,
    do.PrecioUnitario,
    do.Descuento,
    CAST(do.Cantidad * do.PrecioUnitario * (1 - do.Descuento) AS DECIMAL(18,2)) AS MontoVenta,
    CAST(do.Cantidad * do.PrecioUnitario * do.Descuento AS DECIMAL(18,2)) AS MontoDescuento
FROM DetalleOrden do
JOIN Ordenes o 
    ON do.OrdenID = o.OrdenID
JOIN KentFoods_DW.dbo.Dim_Producto dp 
    ON do.ProductoID = dp.ProductoID
JOIN KentFoods_DW.dbo.Dim_Cliente dc 
    ON o.ClienteID = dc.ClienteID
JOIN KentFoods_DW.dbo.Dim_Empleado de 
    ON o.EmpleadoID = de.EmpleadoID
LEFT JOIN KentFoods_DW.dbo.Dim_Transportista dt 
    ON o.EnviadoPor = dt.TransportistaID;</property>
