          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.Fact_Ventas;&#xA;&#xA;DELETE FROM dbo.Dim_Producto;&#xA;DELETE FROM dbo.Dim_Cliente;&#xA;DELETE FROM dbo.Dim_Empleado;&#xA;DELETE FROM dbo.Dim_Transportista;&#xA;DELETE FROM dbo.Dim_Fecha;&#xA;&#xA;IF IDENT_CURRENT('dbo.Dim_Producto') &gt; 1&#xA;    DBCC CHECKIDENT ('dbo.Dim_Producto', RESEED, 0);&#xA;&#xA;IF IDENT_CURRENT('dbo.Dim_Cliente') &gt; 1&#xA;    DBCC CHECKIDENT ('dbo.Dim_Cliente', RESEED, 0);&#xA;&#xA;IF IDENT_CURRENT('dbo.Dim_Empleado') &gt; 1&#xA;    DBCC CHECKIDENT ('dbo.Dim_Empleado', RESEED, 0);&#xA;&#xA;IF IDENT_CURRENT('dbo.Dim_Transportista') &gt; 1&#xA;    DBCC CHECKIDENT ('dbo.Dim_Transportista', RESEED, 0);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
